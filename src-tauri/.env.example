# Launcher build-time secrets — copy to src-tauri/.env (injected via build.rs).
# A Discord *client id* is public by design; nothing secret belongs in here,
# because every value below is readable with `strings` on the shipped binary.
DISCORD_CLIENT_ID=

# Note: the CurseForge key moved to the Spectra server (CURSEFORGE_API_KEY in
# the Spectra-Web repo). The launcher calls /api/curseforge and never sees it.
#
# Telemetry has no key either. It used to send a shared `x-spectra-key`, but a
# constant compiled into a shipped binary is public, so the server dropped the
# check in favour of per-IP rate limits. Sharing an instance authenticates with
# the user's own Spectra session instead.
